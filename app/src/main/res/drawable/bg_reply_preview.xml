<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- الخلفية الخضراء مع إطار ذهبي -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#002F05" />
            <corners android:radius="8dp" />
            <stroke 
                android:width="1dp" 
                android:color="#C5A059" />
        </shape>
    </item>
    
    <!-- الخط الأبيض - يظهر فقط على اليسار -->
    <item
        android:left="0dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners
                android:topLeftRadius="6dp"
                android:bottomLeftRadius="6dp" />
        </shape>
    </item>
    
    <!-- حشوة تمنع تمدد الخط الأبيض -->
    <item
        android:left="3dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#002F05" />
            <corners
                android:topRightRadius="8dp"
                android:bottomRightRadius="8dp" />
        </shape>
    </item>
</layer-list>
