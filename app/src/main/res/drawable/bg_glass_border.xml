<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- الإطار الخارجي اللامع (أبيض من الأعلى وذهبي من الأسفل) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="90"
                android:startColor="#FFFFB300"
                android:centerColor="#4DFFFFFF"
                android:endColor="#FFFFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <!-- تفريغ الداخل ليصبح شفافاً تماماً (ليظهر الـ BlurView) -->
    <item android:bottom="1.5dp" android:top="1.5dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- لمعة زجاجية علوية خفيفة جداً (تأثير 3D) -->
    <item android:bottom="1.5dp" android:top="1.5dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
