<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- إطار دائري فضي بلمسة ذهبية سفلية -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#FFFFD36A"
                android:centerColor="#D9E8F4FF"
                android:endColor="#FFFFFFFF" />
        </shape>
    </item>

    <!-- تعبئة داخلية جليدية شبه شفافة لتغطية التدرج الخارجي -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="oval">
            <solid android:color="#557F9BB8" />
            <stroke
                android:width="0.5dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>

    <!-- انعكاس علوي -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#42FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

</layer-list>
