<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- الطبقة السفلية: الإطار الدائري المتوهج -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#FFFFB300"
                android:centerColor="#33FFFFFF"
                android:endColor="#FFFFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- الطبقة العلوية: الزجاج الداخلي الدائري -->
    <item android:bottom="1.5dp" android:top="1.5dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#991B2436"
                android:endColor="#B30B111A" />
        </shape>
    </item>
</layer-list>
