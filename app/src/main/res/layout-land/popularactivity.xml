<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popularContentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:layoutDirection="locale">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/brightBackgroundTargetPop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <ImageView
            android:id="@+id/imgMainBackgroundPop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/vntrocreen" />
    </eightbitlab.com.blurview.BlurTarget>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerSetsPop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginRight="34dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/blurListBtnPop"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- الشريط العلوي الزجاجي -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurTopBarPop"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="35dp"
        android:background="@drawable/bg_glass_capsule"
        android:clipToOutline="true"
        app:blurOverlayColor="#1AFFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <RelativeLayout
            android:id="@+id/topBarInnerPop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="20dp">
            
            <ImageView
                android:id="@+id/btnBackPop"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/icon_arrow_circle_right_round"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="#FFFFFF"
                android:rotation="180"/> 

            <TextView
                android:id="@+id/tvTitlePop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="رائج 🔥"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:shadowColor="#FF000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </RelativeLayout>
    </eightbitlab.com.blurview.BlurView>

    <!-- زر عرض القائمة المصغرة -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurListBtnPop"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_glass_capsule"
        android:clipToOutline="true"
        app:blurOverlayColor="#1AFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/blurTopBarPop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:id="@+id/btnListSetsPop"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="30dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            
            <TextView
                android:id="@+id/tvListBtnPop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عرض قائمة السيتات"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="#FF000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <!-- طبقة التعليمات للمستخدم الجديد -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tutorialOverlayPop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000" 
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:elevation="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/imgSwipeArrowsPop"
            android:layout_width="50dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_swipe_arrows"
            android:layout_marginBottom="15dp"
            app:layout_constraintBottom_toTopOf="@+id/imgHandSwipePop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/imgHandSwipePop"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_swipe_up_hand"
            android:rotation="-30"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.65" />

        <TextView
            android:id="@+id/tvTutorialLabelPop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:paddingHorizontal="25dp"
            android:paddingVertical="12dp"
            android:background="@drawable/bg_black_rounded"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="5"
            app:layout_constraintTop_toBottomOf="@+id/imgHandSwipePop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
            
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
