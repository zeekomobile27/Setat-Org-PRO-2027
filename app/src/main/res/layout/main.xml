<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainContentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:layoutDirection="locale">

    <FrameLayout
        android:id="@+id/brightBackgroundTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/imgMainBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/zeeko40" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#4D000000" />
    </FrameLayout>

    <eightbitlab.com.blurview.BlurView android:id="@+id/blurTopBar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <eightbitlab.com.blurview.BlurView android:id="@+id/blurBottomBar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:weightSum="4"
        android:paddingHorizontal="4dp"
        android:paddingVertical="5dp"
        android:gravity="top"
        app:layout_constraintTop_toTopOf="parent">

        <!-- زر الحساب -->
        <LinearLayout
            android:id="@+id/btnProfileClick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurProfileBtn"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/bg_glass_circle_border"
                android:clipToOutline="true"
                app:blurOverlayColor="#28DCEBFA">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/imgProfilePic"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_default_user"
                        android:scaleType="centerCrop" />
                </FrameLayout>
            </eightbitlab.com.blurview.BlurView>

            <TextView
                android:id="@+id/tvProfileTopTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:shadowColor="#FF000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />
        </LinearLayout>

        <!-- زر أورج الملكي 2027 -->
        <LinearLayout
            android:id="@+id/btnOrgVipClick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurOrgVipBtn"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_glass_capsule"
                android:clipToOutline="true"
                app:blurOverlayColor="#28DCEBFA">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.zeekoltd.setat.pro.MovingBorderView
                        android:id="@+id/orgVipMovingBorder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvOrgVipBtnText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="أورج الملكي 2027"
                            android:textColor="#FFD700"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:shadowColor="#FF000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="2" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👑"
                            android:textSize="16sp"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </FrameLayout>
            </eightbitlab.com.blurview.BlurView>

            <TextView
                android:id="@+id/tvOrgVipTopTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:shadowColor="#FF000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />
        </LinearLayout>

        <!-- زر اللغة -->
        <LinearLayout
            android:id="@+id/btnLangTopBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurLangBtn"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/bg_glass_circle_border"
                android:clipToOutline="true"
                app:blurOverlayColor="#28DCEBFA">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_language"
                        app:tint="#FFFFFF" />
                </FrameLayout>
            </eightbitlab.com.blurview.BlurView>

            <TextView
                android:id="@+id/tvLangTopTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:shadowColor="#FF000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollViewButtons"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/topBarContainer"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <!-- شريط البحث الزجاجي المتصل -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurSearchBar"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_capsule"
                android:clipToOutline="true"
                app:blurOverlayColor="#28DCEBFA">
                
                <LinearLayout
                    android:id="@+id/btnGlobalSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="15dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search_filter"
                        app:tint="#FFD700"/>
                        
                    <TextView
                        android:id="@+id/tvSearchHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="ابحث عن سيتات أو إيقاعات أو أصوات ..."
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"/>
                        
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        app:tint="#FFFFFF"/>
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <!-- البانر الذكي مع مكبر الصوت -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurSmartBanner"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_glass_capsule"
                android:clipToOutline="true"
                app:blurOverlayColor="#28DCEBFA"
                android:visibility="visible">

                <LinearLayout
                    android:id="@+id/btnSmartBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:clickable="false"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    
                    <TextView
                        android:id="@+id/tvSmartBannerText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:shadowColor="#FF000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:focusable="true"
                        android:focusableInTouchMode="true"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 📢"
                        android:textSize="14sp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <Space android:layout_width="match_parent" android:layout_height="8dp"/>

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurNewSetExclusive"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_capsule"
                android:clipToOutline="true"
                app:blurOverlayColor="#28DCEBFA">

                <LinearLayout
                    android:id="@+id/btnNewSetExclusive"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/tvExclusiveSetTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="سيتات حصرية منوعة"
                        android:textColor="#FFFFFF"
                        android:shadowColor="#FF000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_fire"
                        app:tint="#FFFFFF"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:layout_marginBottom="10dp">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurSetat2"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#28DCEBFA">
                    <LinearLayout
                        android:id="@+id/btnSetat2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌎" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="18sp" android:layout_marginBottom="3dp"/>
                        <TextView android:id="@+id/tvSetat2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سيتات عالمية" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurSetat3"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#28DCEBFA">
                    <LinearLayout
                        android:id="@+id/btnSetat3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_music" app:tint="#FFFFFF" android:layout_marginBottom="3dp"/>
                        <TextView android:id="@+id/tvSetat3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سيتات شعبية" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurSetat5"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#28DCEBFA">
                    <LinearLayout
                        android:id="@+id/btnSetat5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_music" app:tint="#FFFFFF" android:layout_marginBottom="3dp"/>
                        <TextView android:id="@+id/tvSetat5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سيتات دبكات" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:layout_marginBottom="10dp">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurSetat6"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#28DCEBFA">
                    <LinearLayout
                        android:id="@+id/btnSetat6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🇮🇶" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="16sp" android:layout_marginBottom="3dp"/>
                        <TextView android:id="@+id/tvSetat6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سيتات عراقي" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurSetat7"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#28DCEBFA">
                    <LinearLayout
                        android:id="@+id/btnSetat7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🇪🇬" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="16sp" android:layout_marginBottom="3dp"/>
                        <TextView android:id="@+id/tvSetat7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سيتات مصري" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurSetat8"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#28DCEBFA">
                    <LinearLayout
                        android:id="@+id/btnSetat8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_fire" app:tint="#FFFFFF" android:layout_marginBottom="3dp"/>
                        <TextView android:id="@+id/tvSetat8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سيتات إحترافية" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:layout_marginBottom="10dp">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurSetat9"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#28DCEBFA">
                    <LinearLayout
                        android:id="@+id/btnSetat9"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🇩🇿" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="16sp" android:layout_marginBottom="3dp"/>
                        <TextView android:id="@+id/tvSetat9" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سيتات جزائري" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurSetat10"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#28DCEBFA">
                    <LinearLayout
                        android:id="@+id/btnSetat10"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🇸🇾" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="16sp" android:layout_marginBottom="3dp"/>
                        <TextView android:id="@+id/tvSetat10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سيتات سوري" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurSetat11"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#28DCEBFA">
                    <LinearLayout
                        android:id="@+id/btnSetat11"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🇾🇪" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="16sp" android:layout_marginBottom="3dp"/>
                        <TextView android:id="@+id/tvSetat11" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سيتات يمني" android:textColor="#FFFFFF" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>
            </LinearLayout>

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurSetat12"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_capsule"
                android:clipToOutline="true"
                app:blurOverlayColor="#28DCEBFA">

                <LinearLayout
                    android:id="@+id/btnSetat12"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/tvSetat12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ثيمات الأورج"
                        android:textColor="#FFFFFF"
                        android:shadowColor="#FF000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_piano"
                        app:tint="#FFFFFF"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <LinearLayout
                android:id="@+id/newFeaturesContainer"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:weightSum="2"
                android:gravity="center">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurHowToDownloadBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#28DCEBFA">
                    <LinearLayout
                        android:id="@+id/btnHowToDownloadClick"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:id="@+id/tvHowToDownloadText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:shadowColor="#FF000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="2" />
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurHowToAddBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#28DCEBFA">
                    <LinearLayout
                        android:id="@+id/btnHowToAddClick"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:id="@+id/tvHowToAddText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:shadowColor="#FF000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="2" />
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>
            </LinearLayout>

            <!-- الشريط السفلي (كبسولة واحدة متصلة كما في الصورة) -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurBottomNavBar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_glass_capsule"
                android:clipToOutline="true"
                app:blurOverlayColor="#28DCEBFA">

                <LinearLayout
                    android:id="@+id/bottomBarContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:weightSum="4"
                    android:paddingHorizontal="10dp"
                    android:gravity="center_vertical">

                    <!-- المشاركة -->
                    <LinearLayout
                        android:id="@+id/btnShareClick"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/icon_share_round"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:id="@+id/tvShareTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:shadowColor="#FF000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="2" />
                    </LinearLayout>

                    <!-- فاصل زجاجي (خط رفيع) -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="35dp"
                        android:background="#4DFFFFFF"
                        android:layout_gravity="center_vertical"/>

                    <!-- المفضلة -->
                    <LinearLayout
                        android:id="@+id/btnFavoritesClick"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/icon_star"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:id="@+id/tvFavoritesText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:shadowColor="#FF000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="2" />
                    </LinearLayout>

                    <!-- فاصل زجاجي (خط رفيع) -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="35dp"
                        android:background="#4DFFFFFF"
                        android:layout_gravity="center_vertical"/>

                    <!-- الإشعارات -->
                    <LinearLayout
                        android:id="@+id/btnNotificationsClick"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/icon_circle_notifications_round"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:id="@+id/tvNotifTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:shadowColor="#FF000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="2" />
                    </LinearLayout>

                    <!-- فاصل زجاجي (خط رفيع) -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="35dp"
                        android:background="#4DFFFFFF"
                        android:layout_gravity="center_vertical"/>

                    <!-- الدعم -->
                    <LinearLayout
                        android:id="@+id/btnChatClick"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_chat"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:id="@+id/tvChatTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:shadowColor="#FF000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="2" />
                    </LinearLayout>
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
