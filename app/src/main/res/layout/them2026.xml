<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:ns0="http://schemas.android.com/apk/res/android" xmlns:ns1="http://schemas.android.com/apk/res-auto" ns0:id="@+id/mainContentView" ns0:layout_width="match_parent" ns0:layout_height="match_parent" ns0:background="#000000" ns0:layoutDirection="locale">

    <eightbitlab.com.blurview.BlurTarget ns0:id="@+id/brightBackgroundTarget" ns0:layout_width="match_parent" ns0:layout_height="match_parent" ns1:layout_constraintTop_toTopOf="parent" ns1:layout_constraintBottom_toBottomOf="parent">
        
