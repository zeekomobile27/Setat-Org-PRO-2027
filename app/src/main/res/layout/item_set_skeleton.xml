<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/sideIconsSkeleton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/bg_glass_circle_border" />

        <View
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_glass_circle_border" />

        <View
            android:layout_width="20dp"
            android:layout_height="10dp"
            android:layout_marginBottom="15dp"
            android:background="#CCFFFFFF" />

        <View
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="@drawable/bg_glass_circle_border" />
    </LinearLayout>

    <View
        android:id="@+id/centerWindowSkeleton"
        android:layout_width="260dp"
        android:layout_height="350dp"
        android:background="@drawable/bg_glass_border"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/sideIconsSkeleton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.43" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_glass_border"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="15dp"
        android:gravity="center_vertical|start"
        app:layout_constraintTop_toBottomOf="@id/centerWindowSkeleton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="180dp"
            android:layout_height="24dp"
            android:background="#CCFFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="10dp"
            android:background="#99FFFFFF" />
            
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="50dp"
            android:background="#99FFFFFF" />

        <View
            android:layout_width="220dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_glass_capsule" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>