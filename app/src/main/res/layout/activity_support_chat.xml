<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainContentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:layoutDirection="locale">

    <!-- 🌟 الهدف الساطع للزجاج 🌟 -->
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/brightBackgroundTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <ImageView
            android:id="@+id/imgChatBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/vntrocreen" />
    </eightbitlab.com.blurview.BlurTarget>

    <!-- 🌟 التعتيم 70% 🌟 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 🌟 الشريط العلوي الزجاجي الموحد 🌟 -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurTopBar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/bg_glass_capsule"
        android:clipToOutline="true"
        app:blurOverlayColor="#1AFFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:id="@+id/topBarChat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp">

            <!-- زر الرجوع -->
            <LinearLayout
                android:id="@+id/btnBackFromChat"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="#FFFFFF"/>

                <TextView
                    android:id="@+id/tvBackText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="رجوع"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:layout_marginTop="1dp"
                    android:shadowColor="#FF000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"/>
            </LinearLayout>

            <!-- العنوان والتوثيق -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tvChatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZEEKO ORG"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:shadowColor="#FF000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"/>

                <ImageView
                    android:id="@+id/imgVerifiedSupport"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_verified"
                    android:layout_marginStart="4dp"
                    android:visibility="visible"/>
            </LinearLayout>

            <!-- أيقونة الحذف النهائي للمطور -->
            <ImageView
                android:id="@+id/btnDeleteUser"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_delete"
                app:tint="#FF4C4C"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <!-- أيقونة الحظر للمطور -->
            <ImageView
                android:id="@+id/btnBanUser"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_ban"
                app:tint="#FFFFFF"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <ImageView
                android:id="@+id/imgDevProfileTopBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_default_user"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_circle"/>

            <TextView
                android:id="@+id/tvOnlineCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#00FFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:visibility="gone"/>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/blurTopBar"
        app:layout_constraintBottom_toTopOf="@id/tvTypingIndicator"/>

    <TextView
        android:id="@+id/tvTypingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#C5A059"
        android:textSize="12sp"
        android:textStyle="bold|italic"
        android:visibility="gone"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toTopOf="@id/blurBottomBar"/>

    <!-- 🌟 شريط الإرسال السفلي الزجاجي 🌟 -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="65dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginBottom="25dp"
        android:background="@drawable/bg_glass_capsule"
        android:clipToOutline="true"
        app:blurOverlayColor="#1AFFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:id="@+id/bottomBarChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/btnEmoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_emoji"
                app:tint="#FFFFFF"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="45dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_glass_border"
                android:hint="اكتب رسالتك..."
                android:textColor="#FFFFFF"
                android:textColorHint="#99FFFFFF"
                android:textSize="15sp"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp"
                android:maxLines="4"
                android:inputType="textShortMessage|textMultiLine"/>

            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_send"
                app:tint="#00FFFF"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <!-- 🌟 رسالة الحظر السفلية (تظهر مكان شريط الإرسال عند الحظر) 🌟 -->
    <TextView
        android:id="@+id/tvBannedMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="65dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginBottom="25dp"
        android:background="@drawable/bg_glass_capsule"
        android:text="عذراً، لقد تم إيقافك من مراسلة الدعم الفني."
        android:textColor="#FF4C4C"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>