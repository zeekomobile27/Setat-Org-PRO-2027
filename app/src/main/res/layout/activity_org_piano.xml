<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@drawable/vntrocreen">

    <FrameLayout
        android:id="@+id/pianoViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.45">
        <com.zeekoltd.setat.pro.PianoView
            android:id="@+id/pianoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <View
        android:id="@+id/neonLine"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#D4CA6A"
        app:layout_constraintBottom_toTopOf="@id/pianoViewContainer"/>

    <LinearLayout
        android:id="@+id/tuningRowContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toTopOf="@id/neonLine">

        <LinearLayout
            android:id="@+id/tashreeqNotesRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="12" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="4dp">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_back" android:layout_marginRight="4dp" app:tint="#FFFFFF"/>
            <TextView android:id="@+id/tvTashreeqLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="التشريق" android:textColor="#FFFFFF" android:textSize="16sp" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/centerScreenContainer"
        android:layout_width="290dp"
        android:layout_height="115dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/tuningRowContainer"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <ImageView
            android:id="@+id/centerScreenImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/zeeko14" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:padding="2dp">

            <LinearLayout
                android:id="@+id/dashContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- 🚀 قسم الإيقاعات -->
                <LinearLayout
                    android:id="@+id/dashRhythmSection"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:layout_marginRight="2dp">
                    
                    <TextView
                        android:id="@+id/tvLabelRhythms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الإيقاعات"
                        android:textColor="#D4CA6A"
                        android:textSize="9.5sp"
                        android:gravity="center"
                        android:layout_marginBottom="2dp"
                        android:includeFontPadding="false"/>
                        
                    <LinearLayout
                        android:id="@+id/rowRhythm1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dash_red"
                        android:gravity="center"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="4dp"
                        android:layout_marginBottom="2dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tvDashRhythm1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rhythm 1"
                            android:textColor="#FFCCCC"
                            android:textSize="9.5sp"
                            android:singleLine="true"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                    
                    <LinearLayout
                        android:id="@+id/rowRhythm2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dash_red"
                        android:gravity="center"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="4dp"
                        android:layout_marginBottom="2dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tvDashRhythm2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rhythm 2"
                            android:textColor="#AACCFF"
                            android:textSize="9.5sp"
                            android:singleLine="true"
                            android:includeFontPadding="false"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="tempo" android:textColor="#DDDDDD" android:textSize="8sp" android:includeFontPadding="false"/>
                        <TextView android:id="@+id/tvDashTempo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="#DDDDDD" android:textSize="8sp" android:includeFontPadding="false"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 🚀 قسم الأصوات -->
                <LinearLayout
                    android:id="@+id/dashSoundSection"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.8"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/tvLabelSounds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الأصوات"
                        android:textColor="#D4CA6A"
                        android:textSize="9.5sp"
                        android:gravity="center"
                        android:layout_marginBottom="2dp"
                        android:includeFontPadding="false"/>
                        
                    <LinearLayout
                        android:id="@+id/rowSound1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dash_blue"
                        android:gravity="center"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="4dp"
                        android:layout_marginBottom="2dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tvDashSound1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sound 1"
                            android:textColor="#AACCFF"
                            android:textSize="9.5sp"
                            android:singleLine="true"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                    
                    <LinearLayout
                        android:id="@+id/rowSound2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dash_blue"
                        android:gravity="center"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="4dp"
                        android:layout_marginBottom="2dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tvDashSound2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sound 2"
                            android:textColor="#AACCFF"
                            android:textSize="9.5sp"
                            android:singleLine="true"
                            android:includeFontPadding="false"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/tvDashOctave1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="octave 0" android:textColor="#DDDDDD" android:textSize="8sp" android:includeFontPadding="false"/>
                        <TextView android:id="@+id/tvDashTrans" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="b/# 0" android:textColor="#DDDDDD" android:textSize="8sp" android:includeFontPadding="false"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvCenterLoadingText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="يرجى الانتظار..."
                android:textColor="#FFD700"
                android:textSize="18sp"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:visibility="gone"/>
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/adBannerContainer"
        android:layout_width="350dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/zeeko15"
            android:scaleType="fitXY" />
    </FrameLayout>

    <!-- 1️⃣ القطعة الأولى: عصا التحكم (في أعلى اليسار تماماً) -->
    <LinearLayout
        android:id="@+id/topLeftJoystickGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="6dp"
        android:layoutDirection="ltr"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        
        <FrameLayout android:id="@+id/pitchBendContainer" android:layout_width="72dp" android:layout_height="72dp">
            <View android:id="@+id/pitchBendBg" android:layout_width="match_parent" android:layout_height="match_parent" />
            <ImageView
                android:id="@+id/pitchBendThumb"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/setat"
                android:scaleType="fitCenter" />
        </FrameLayout>
        
        <TextView android:id="@+id/tvJoystickTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اورج زيكو VIP" android:textColor="#D4CA6A" android:textSize="10sp" android:layout_marginTop="4dp" android:paddingHorizontal="10dp" android:paddingVertical="2dp" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5"/>
    </LinearLayout>

    <!-- 2️⃣ القطعة الثانية: الموجات الصوتية (قطعة مستقلة على يمين العصا) -->
    <LinearLayout
        android:id="@+id/wavesGroup"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginBottom="18dp"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@id/topLeftJoystickGroup"
        app:layout_constraintLeft_toRightOf="@id/topLeftJoystickGroup"
        app:layout_constraintRight_toLeftOf="@id/centerScreenContainer">
        
        <View android:id="@+id/eqCyan1" android:layout_width="8dp" android:layout_height="4dp" android:layout_marginRight="4dp" android:background="#00FFFF" />
        <View android:id="@+id/eqGold1" android:layout_width="8dp" android:layout_height="4dp" android:layout_marginRight="4dp" android:background="#C5A059" />
        <View android:id="@+id/eqCyan2" android:layout_width="8dp" android:layout_height="4dp" android:layout_marginRight="4dp" android:background="#00FFFF" />
        <View android:id="@+id/eqGold2" android:layout_width="8dp" android:layout_height="4dp" android:layout_marginRight="4dp" android:background="#C5A059" />
        <View android:id="@+id/eqCyan3" android:layout_width="8dp" android:layout_height="4dp" android:layout_marginRight="4dp" android:background="#00FFFF" />
        <View android:id="@+id/eqGold3" android:layout_width="8dp" android:layout_height="4dp" android:background="#C5A059" />
    </LinearLayout>

    <!-- 3️⃣ القطعة الثالثة: مجموعة الإيقاع (تم إزالة الهامش الخانق، وأصبحت تتمدد بعرض الشاشة الأيسر بالكامل) -->
    <LinearLayout
        android:id="@+id/rhythmControlGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="bottom"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@id/centerScreenContainer"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/centerScreenContainer">

        <TextView android:id="@+id/tvLabelRhythmCtrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تحكم الإيقاع" android:textColor="#D4CA6A" android:textSize="11sp" android:gravity="center" android:layout_marginBottom="4dp" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:weightSum="5">
            <TextView android:id="@+id/ph_l_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="3dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:text="فاصل" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
            <TextView android:id="@+id/ph_l_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="3dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:text="باد 2" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
            <TextView android:id="@+id/ph_l_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="3dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:text="باد 1" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
            <TextView android:id="@+id/ph_l_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="3dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:text="السرعة" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
            <TextView android:id="@+id/ph_l_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:text="تشغيل" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 🚀 مجموعة المؤثرات: أصبحت مرنة (Fluid) بدون مسافات زائدة -->
    <LinearLayout
        android:id="@+id/effectsControlGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="bottom"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@id/centerScreenContainer"
        app:layout_constraintLeft_toRightOf="@id/centerScreenContainer"
        app:layout_constraintRight_toRightOf="parent">

        <TextView android:id="@+id/tvLabelFX1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=" " android:textColor="#D4CA6A" android:textSize="11sp" android:gravity="center" android:layout_marginBottom="2dp" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:weightSum="5" android:layout_marginBottom="4dp">
            <TextView android:id="@+id/btnResetTuning" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:layout_marginRight="3dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:text="بدون تشريق" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
            <TextView android:id="@+id/btnDefaultSet" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:layout_marginRight="3dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:text="الإفتراضي" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
            <TextView android:id="@+id/ph_r_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:singleLine="true"/>
        </LinearLayout>

        <TextView android:id="@+id/tvLabelFX2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="المؤثرات" android:textColor="#D4CA6A" android:textSize="11sp" android:gravity="center" android:layout_marginBottom="2dp" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:weightSum="4">
            <TextView android:id="@+id/btnVolume" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="3dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:text="الصوت" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
            <TextView android:id="@+id/btnTranspose" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="3dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:text="ترانسبوس" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
            <TextView android:id="@+id/btnOctave" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="3dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:text="أوكتاف" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
            <TextView android:id="@+id/btnTarteel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ترتيل" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5" android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 🚀 مجموعة الأزرار العلوية: حجم مرن (wrap_content) لتجنب الخروج عن الشاشة -->
    <LinearLayout
        android:id="@+id/topRightGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginRight="8dp"
        android:layoutDirection="ltr"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        
        <TextView android:id="@+id/btnPlaceholderTopRight2" android:layout_width="wrap_content" android:minWidth="50dp" android:paddingHorizontal="6dp" android:layout_height="38dp" android:layout_marginRight="4dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5"/>
        
        <TextView android:id="@+id/btnImportSet" android:layout_width="wrap_content" android:minWidth="50dp" android:paddingHorizontal="6dp" android:layout_height="38dp" android:layout_marginRight="4dp" android:text="إضافة سيت" android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:shadowColor="#000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="5"/>
        
        <ImageView android:id="@+id/btnBack" android:layout_width="wrap_content" android:minWidth="40dp" android:paddingHorizontal="8dp" android:layout_height="38dp" android:src="@drawable/ic_back" android:rotation="180" android:clickable="true" android:focusable="true" app:tint="#FFFFFF"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>
