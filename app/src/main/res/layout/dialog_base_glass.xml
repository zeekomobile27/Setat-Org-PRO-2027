<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurCenterWindow"
        android:layout_width="320dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_glass_border"
        android:clipToOutline="true"
        app:blurOverlayColor="#1AFFFFFF"
        app:layout_constraintTop_toTopOf="@+id/mainContentWrapper"
        app:layout_constraintBottom_toBottomOf="@+id/mainContentWrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.zeekoltd.setat.pro.MovingBorderView
        android:id="@+id/centerMovingBorder"
        android:layout_width="320dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/mainContentWrapper"
        app:layout_constraintBottom_toBottomOf="@+id/mainContentWrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/mainContentWrapper"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="30dp"
        android:paddingBottom="15dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:gravity="center"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvDialogDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/dialogDynamicContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal" />
            
    </LinearLayout>

    <!-- نظام القصاصات الورقية الاحتفالية (للنوافذ) -->
    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfettiViewDialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="100dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
