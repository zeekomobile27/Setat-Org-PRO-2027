<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="6dp"
    android:paddingHorizontal="8dp">

    <!-- ========== تخطيط اليسار (رسائلي) ========== -->
    <LinearLayout
        android:id="@+id/layoutLeft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgAvatarLeft"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_default_user"
            android:scaleType="centerCrop"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_avatar_circle"/>

        <LinearLayout
            android:id="@+id/contentLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp"
            android:gravity="start">

            <LinearLayout
                android:id="@+id/senderInfoLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <TextView
                    android:id="@+id/tvNameLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اسم"
                    android:textColor="#C5A059"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginEnd="4dp"/>

                <ImageView
                    android:id="@+id/imgVerifiedLeft"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_verified"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bubbleLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:minWidth="80dp"
                android:maxWidth="260dp">

                <!-- صندوق الاقتباس داخل الفقاعة اليسرى -->
                <LinearLayout
                    android:id="@+id/layoutReplyLeft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_reply_box"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvReplyNameLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="اسم المستخدم"
                        android:textColor="#C5A059"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvReplyTextLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="نص الرسالة..."
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTextLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textDirection="locale"/>

                <!-- 🌟 زر الفتح الذكي للروابط (يسار) 🌟 -->
                <TextView
                    android:id="@+id/btnOpenLinkLeft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_glass_border"
                    android:gravity="center"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="8dp"
                    android:textColor="#00FFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:shadowColor="#FF000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvTimeLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#AAFFFFFF"
                    android:textSize="10sp"
                    android:layout_gravity="start"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <!-- حاوية التفاعلات -->
            <LinearLayout
                android:id="@+id/layoutReactionsLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start"
                android:layout_marginTop="2dp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ========== تخطيط اليمين (الآخرين) ========== -->
    <LinearLayout
        android:id="@+id/layoutRight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/contentRight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="6dp"
            android:gravity="end">

            <LinearLayout
                android:id="@+id/senderInfoRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <ImageView
                    android:id="@+id/imgVerifiedRight"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_verified"
                    android:visibility="gone"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tvNameRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اسم"
                    android:textColor="#C5A059"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bubbleRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:minWidth="80dp"
                android:maxWidth="260dp">

                <!-- صندوق الاقتباس داخل الفقاعة اليمنى -->
                <LinearLayout
                    android:id="@+id/layoutReplyRight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_reply_box"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvReplyNameRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="اسم المستخدم"
                        android:textColor="#C5A059"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvReplyTextRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="نص الرسالة..."
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTextRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textDirection="locale"/>

                <!-- 🌟 زر الفتح الذكي للروابط (يمين) 🌟 -->
                <TextView
                    android:id="@+id/btnOpenLinkRight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_glass_border"
                    android:gravity="center"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="8dp"
                    android:textColor="#C5A059"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:shadowColor="#FF000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvTimeRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#AAFFFFFF"
                    android:textSize="10sp"
                    android:layout_gravity="start"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <!-- حاوية التفاعلات -->
            <LinearLayout
                android:id="@+id/layoutReactionsRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="2dp"
                android:visibility="gone"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/imgAvatarRight"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_default_user"
            android:scaleType="centerCrop"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_avatar_circle"/>
    </LinearLayout>
</LinearLayout>
