<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:ns0="http://schemas.android.com/apk/res/android" xmlns:ns1="http://schemas.android.com/apk/res-auto" ns0:layout_width="match_parent" ns0:layout_height="match_parent" ns0:fillViewport="true" ns0:clipToPadding="false" ns0:padding="8dp" ns0:scrollbars="none"><LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:orientation="horizontal" ns0:gravity="center_vertical" ns0:layoutDirection="ltr" ns0:baselineAligned="false"><LinearLayout ns0:id="@+id/sideIconsContainer" ns0:layout_width="60dp" ns0:layout_height="wrap_content" ns0:orientation="vertical" ns0:gravity="center" ns0:layout_marginEnd="8dp">

        <eightbitlab.com.blurview.BlurView ns0:id="@+id/blurDevIcon" ns0:layout_width="55dp" ns0:layout_height="55dp" ns0:layout_marginBottom="15dp" ns0:background="@drawable/bg_glass_circle_border" ns0:clipToOutline="true" ns1:blurOverlayColor="#1AFFFFFF">
            <FrameLayout ns0:layout_width="match_parent" ns0:layout_height="match_parent">
                
                <androidx.cardview.widget.CardView ns0:layout_width="45dp" ns0:layout_height="45dp" ns0:layout_gravity="center" ns1:cardCornerRadius="22.5dp" ns1:cardElevation="0dp" ns1:cardBackgroundColor="@android:color/transparent">
                    
                    <ImageView ns0:id="@+id/imgDevIcon" ns0:layout_width="match_parent" ns0:layout_height="match_parent" ns0:scaleType="centerCrop" ns0:src="@drawable/ic_default_user" />
                </androidx.cardview.widget.CardView>
                
            </FrameLayout>
        </eightbitlab.com.blurview.BlurView>

        <eightbitlab.com.blurview.BlurView ns0:id="@+id/blurLikeBtn" ns0:layout_width="55dp" ns0:layout_height="55dp" ns0:layout_marginBottom="5dp" ns0:background="@drawable/bg_glass_circle_border" ns0:clipToOutline="true" ns1:blurOverlayColor="#1AFFFFFF">
            <ImageView ns0:id="@+id/btnLike" ns0:layout_width="26dp" ns0:layout_height="26dp" ns0:layout_gravity="center" ns0:src="@drawable/icon_heart" ns1:tint="#FFFFFF" />
        </eightbitlab.com.blurview.BlurView>
        
        <TextView ns0:id="@+id/tvLikesCount" ns0:layout_width="wrap_content" ns0:layout_height="wrap_content" ns0:layout_marginBottom="15dp" ns0:text="0" ns0:textColor="#FFFFFF" ns0:textSize="12sp" ns0:textStyle="bold" ns0:shadowColor="#FF000000" ns0:shadowDx="1" ns0:shadowDy="1" ns0:shadowRadius="2" />

        <eightbitlab.com.blurview.BlurView ns0:id="@+id/blurFavBtn" ns0:layout_width="55dp" ns0:layout_height="55dp" ns0:background="@drawable/bg_glass_circle_border" ns0:clipToOutline="true" ns1:blurOverlayColor="#1AFFFFFF">
            <ImageView ns0:id="@+id/btnFavorite" ns0:layout_width="24dp" ns0:layout_height="24dp" ns0:layout_gravity="center" ns0:src="@drawable/icon_star" ns1:tint="#FFFFFF" />
        </eightbitlab.com.blurview.BlurView>
    </LinearLayout>

    <eightbitlab.com.blurview.BlurView ns0:id="@+id/blurCenterWindow" ns0:layout_width="0dp" ns0:layout_height="245dp" ns0:background="@drawable/bg_glass_border" ns0:clipToOutline="true" ns1:blurOverlayColor="#1AFFFFFF" ns0:layout_weight="1" ns0:layout_marginEnd="10dp"> 

        <com.zeekoltd.setat.pro.MovingBorderView ns0:id="@+id/centerMovingBorder" ns0:layout_width="match_parent" ns0:layout_height="match_parent" />

        <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="match_parent" ns0:orientation="vertical" ns0:gravity="center" ns0:paddingTop="6dp" ns0:paddingBottom="6dp">

            <TextView ns0:id="@+id/tvPreviewLabel" ns0:layout_width="wrap_content" ns0:layout_height="wrap_content" ns0:layout_marginBottom="2dp" ns0:text="معاينة السيت" ns0:textColor="#FFFFFF" ns0:textSize="18sp" ns0:textStyle="bold" ns0:shadowColor="#FF000000" ns0:shadowDx="1" ns0:shadowDy="1" ns0:shadowRadius="2" />

            <com.zeekoltd.setat.pro.SmoothWaveView ns0:id="@+id/smoothWave" ns0:layout_width="match_parent" ns0:layout_height="25dp" ns0:layout_marginTop="5dp" />

            <ImageView ns0:id="@+id/btnPlayPause" ns0:layout_width="42dp" ns0:layout_height="42dp" ns0:layout_marginTop="2dp" ns0:src="@drawable/ic_play_glow" ns0:clickable="true" ns0:focusable="true" ns0:background="?attr/selectableItemBackgroundBorderless" />

            <TextView ns0:id="@+id/tvPlayStatus" ns0:layout_width="wrap_content" ns0:layout_height="wrap_content" ns0:layout_marginTop="5dp" ns0:text="تشغيل" ns0:textColor="#E0E0E0" ns0:textSize="14sp" ns0:textStyle="bold" />

            <ProgressBar ns0:id="@+id/audioLoadingBar" ns0:layout_width="40dp" ns0:layout_height="40dp" ns0:layout_marginTop="15dp" ns0:indeterminateTint="#FFFFFF" ns0:visibility="gone" />

            <ImageView ns0:id="@+id/imgOrgPreview" ns0:layout_width="match_parent" ns0:layout_height="60dp" ns0:layout_marginTop="3dp" ns0:scaleType="fitCenter" ns0:src="@drawable/img_org_preview" />
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <eightbitlab.com.blurview.BlurView ns0:id="@+id/blurBottomInfo" ns0:layout_width="0dp" ns0:layout_height="wrap_content" ns0:background="@drawable/bg_glass_border" ns0:clipToOutline="true" ns1:blurOverlayColor="#1AFFFFFF" ns0:layout_weight="1" ns0:layout_marginTop="0dp">

        <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="match_parent" ns0:orientation="vertical" ns0:paddingHorizontal="10dp" ns0:paddingVertical="10dp" ns0:gravity="center_vertical|start">

            <TextView ns0:id="@+id/tvSetTitle" ns0:layout_width="wrap_content" ns0:layout_height="wrap_content" ns0:text="سيت عراقي جديد" ns0:textColor="#FFFFFF" ns0:textSize="20sp" ns0:textStyle="bold" ns0:shadowColor="#FF000000" ns0:shadowDx="1" ns0:shadowDy="1" ns0:shadowRadius="3" />

            <TextView ns0:id="@+id/tvSetDescription" ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:layout_marginTop="4dp" ns0:text="ايقاعات واصوات جديدة احترافية" ns0:textColor="#E0E0E0" ns0:textSize="14sp" ns0:maxLines="2" ns0:ellipsize="end" />

            <eightbitlab.com.blurview.BlurView ns0:id="@+id/blurDownloadBtn" ns0:layout_width="match_parent" ns0:layout_height="40dp" ns0:layout_marginTop="8dp" ns0:layout_gravity="center_horizontal" ns0:background="@drawable/bg_glass_capsule" ns0:clipToOutline="true" ns1:blurOverlayColor="#33FFFFFF">
                
                <LinearLayout ns0:id="@+id/btnDownloadSet" ns0:layout_width="match_parent" ns0:layout_height="match_parent" ns0:orientation="horizontal" ns0:gravity="center" ns0:clickable="true" ns0:focusable="true" ns0:background="?attr/selectableItemBackground">
                    
                    <TextView ns0:id="@+id/tvDownloadLabel" ns0:layout_width="wrap_content" ns0:layout_height="wrap_content" ns0:text="تحميل السيت" ns0:textColor="#FFFFFF" ns0:textSize="15sp" ns0:textStyle="bold" />
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

</LinearLayout></ScrollView>