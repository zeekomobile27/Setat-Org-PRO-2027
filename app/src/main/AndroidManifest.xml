<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. صلاحيات الإنترنت والشبكة الأساسية -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    
    <!-- 2. صلاحيات إشعارات أندرويد 13+ (مهم جداً) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- 3. صلاحية معرّف الإعلانات الإلزامية لأندرويد 13+ (AdMob) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    
    <!-- 4. صلاحيات التخزين الآمنة (متوافقة مع سياسات Scoped Storage من جوجل) -->
    <!-- نطلب صلاحية القراءة العادية للإصدارات القديمة فقط (أندرويد 12 وما دون) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- في أندرويد 13 وما فوق، نطلب صلاحية قراءة الملفات الصوتية فقط لبرامج الموسيقى -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    
    <!-- 5. إبقاء الشاشة مضاءة أثناء العزف -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 6. إخبار النظام بأن التطبيق يعتمد على اللمس المتعدد (للعزف) ولكن بشكل غير إلزامي لدعم الأجهزة الضعيفة -->
    <uses-feature android:name="android.hardware.touchscreen.multitouch" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen.multitouch.distinct" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen.multitouch.jazzhand" android:required="false" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/setat"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false" 
        android:largeHeap="true"
        tools:targetApi="36">

        <!-- شاشة البداية (الوحيدة المسموح لها بالتصدير) -->
        <activity
            android:name=".SplashsctivityActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- باقي الشاشات تم إزالة قيد الـ Portrait منها استجابةً لسياسة جوجل للتابلت و Android 16 -->
        <activity android:name=".MainActivity" android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".MainactivityActivity" android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".SetatshabiActivity" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".SetatmonwahActivity" android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".NewsetatActivity" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".SetatdabakatActivity" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".SetatiraqActivity" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".SetategeptActivity" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".SetatehtrafeActivity" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".Org2025Activity" android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".Them2026Activity" android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".AlertActivity" android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".LanguageActivity" android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".DzirActivity" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".YemeActivity" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".NewActivity" android:hardwareAccelerated="true" android:exported="false" />
        
        <!-- إضافة الشاشة الشائعة الجديدة هنا -->
        <activity android:name=".PopularActivity" android:hardwareAccelerated="true" android:exported="false" />
        
        <activity android:name=".SoriActivity" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".ChatActivity" android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".SupportChatActivity" android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".AdminChatsListActivity" android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".FavoritesActivity" android:hardwareAccelerated="true" android:exported="false" />
        <activity android:name=".SearchActivity" android:hardwareAccelerated="true" android:exported="false" />

        <!-- شاشة العزف: الاتجاه الأفقي على الهواتف، مع السماح بالتكيّف على الشاشات الكبيرة -->
        <activity
            android:name=".OrgPianoActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:hardwareAccelerated="true"
            android:exported="false" />

        <!-- UCrop 2.2.11 يدعم Edge-to-Edge؛ لا نفرض اتجاهاً ثابتاً على الشاشات الكبيرة -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:theme="@style/Theme.UCrop"
            android:exported="false" />

        <!-- خدمة Firebase للإشعارات -->
        <service
            android:name=".MyFcmService"
            android:exported="false"
            android:stopWithTask="false"
            android:directBootAware="true">
            <intent-filter android:priority="-1">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- إعدادات إشعارات فايربيس -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_priority_channel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/setat" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@android:color/holo_blue_bright" />
            
        <!-- معرف حساب إعلانات جوجل AdMob التجريبي -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6135301066898637~2191182433" />

        <!-- مزود الملفات الآمن لمشاركة الملفات محلياً -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
